{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4174/",
        "http://127.0.0.1:4174/vision.html",
        "http://127.0.0.1:4174/docs/commands.html"
      ],
      "startServerCommand": "node tests/lhci-server.mjs",
      "startServerReadyPattern": "jx site:",
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
